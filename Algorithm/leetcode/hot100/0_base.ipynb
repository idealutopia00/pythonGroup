   "source": [
    "nums = [-2,-1,-3,-4,-1,-2,-1,-5,-4]\n",
    "f = [0] * len(nums)\n",
    "f[0] = nums[0]\n",
    "for i in range(1, len(nums)):\n",
    "    f[i] = max(f[i - 1], 0) + nums[i]\n",
    "print(f)"
